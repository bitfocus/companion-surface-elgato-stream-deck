{
	"name": "companion-surface-elgato-stream-deck",
	"version": "1.5.2",
	"main": "dist/main.js",
	"type": "module",
	"scripts": {
		"postinstall": "husky && run build:artwork",
		"format": "prettier -w .",
		"package": "run build && companion-surface-build",
		"build": "rimraf dist && run build:artwork && run build:main && run build:manifest-usb-ids",
		"build:artwork": "node ./tools/build-artwork.mjs",
		"build:main": "tsc -p tsconfig.build.json",
		"build:manifest-usb-ids": "node ./tools/update-usb-ids.mjs",
		"update:firmware-versions": "node ./tools/update-firmware-versions.mjs",
		"dev": "run build:artwork && tsc -p tsconfig.build.json --watch",
		"preview:artwork": "node ./tools/preview-artwork.mjs",
		"lint:raw": "eslint",
		"lint": "run lint:raw ."
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bitfocus/companion-surface-elgato-stream-deck.git"
	},
	"engines": {
		"node": "^26.8",
		"yarn": "^4"
	},
	"dependencies": {
		"@companion-surface/base": "1.5.0-nightly-claude-keen-tesla-ekqmu3-20261003-161950-932edce",
		"@elgato-stream-deck/node": "^7.7.1",
		"@elgato-stream-deck/tcp": "^7.7.1",
		"@julusian/jpeg-turbo": "^3.0.1",
		"nanoid": "^6.0.1",
		"semver": "^7.8.5"
	},
	"devDependencies": {
		"@companion-module/tools": "^3.1.0",
		"@types/node": "^26.5.1",
		"@types/semver": "^7.8.0",
		"eslint": "^10.10.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.5.1",
		"prettier": "^3.9.6",
		"rimraf": "^6.1.3",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.70.0"
	},
	"prettier": "@companion-module/tools/.prettierrc.json",
	"lint-staged": {
		"*.{css,json,md,scss}": [
			"prettier --write"
		],
		"*.{ts,tsx,js,jsx}": [
			"yarn lint:raw --fix"
		]
	},
	"packageManager": "yarn@4.18.0",
	"resolutions": {
		"@elgato-stream-deck/core": "portal:/home/julus/Projects/libs/node-elgato-stream-deck/packages/core",
		"@elgato-stream-deck/node": "portal:/home/julus/Projects/libs/node-elgato-stream-deck/packages/node",
		"@elgato-stream-deck/node-lib": "portal:/home/julus/Projects/libs/node-elgato-stream-deck/packages/node-lib",
		"@elgato-stream-deck/tcp": "portal:/home/julus/Projects/libs/node-elgato-stream-deck/packages/tcp",
		"@elgato-stream-deck/webhid": "portal:/home/julus/Projects/libs/node-elgato-stream-deck/packages/webhid",
		"@elgato-stream-deck/webhid-demo": "portal:/home/julus/Projects/libs/node-elgato-stream-deck/packages/webhid-demo"
	}
}
