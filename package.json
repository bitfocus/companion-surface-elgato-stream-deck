{
	"name": "companion-surface-elgato-stream-deck",
	"version": "1.5.0",
	"main": "dist/main.js",
	"type": "module",
	"scripts": {
		"postinstall": "husky",
		"format": "prettier -w .",
		"package": "run build && companion-surface-build",
		"build": "rimraf dist && run build:main && run build:manifest-usb-ids",
		"build:main": "tsc -p tsconfig.build.json",
		"build:manifest-usb-ids": "node ./tools/update-usb-ids.mjs",
		"update:firmware-versions": "node ./tools/update-firmware-versions.mjs",
		"dev": "tsc -p tsconfig.build.json --watch",
		"lint:raw": "eslint",
		"lint": "run lint:raw ."
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bitfocus/companion-surface-elgato-stream-deck.git"
	},
	"engines": {
		"node": "^26.8",
		"yarn": "^4"
	},
	"dependencies": {
		"@companion-surface/base": "~1.4.0",
		"@elgato-stream-deck/node": "^7.7.0",
		"@elgato-stream-deck/tcp": "^7.7.0",
		"@julusian/jpeg-turbo": "^3.0.1",
		"nanoid": "^6.0.1",
		"semver": "^7.8.5"
	},
	"devDependencies": {
		"@companion-module/tools": "^3.1.0",
		"@types/node": "^26.5.1",
		"@types/semver": "^7.8.0",
		"eslint": "^10.10.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.5.1",
		"prettier": "^3.9.6",
		"rimraf": "^6.1.3",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.70.0"
	},
	"prettier": "@companion-module/tools/.prettierrc.json",
	"lint-staged": {
		"*.{css,json,md,scss}": [
			"prettier --write"
		],
		"*.{ts,tsx,js,jsx}": [
			"yarn lint:raw --fix"
		]
	},
	"packageManager": "yarn@4.18.0"
}
